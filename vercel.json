{
  "buildCommand": null,
  "framework": null,
  "cleanUrls": true,
  "functions": {
    "api/router.py": {
      "maxDuration": 30,
      "excludeFiles": "{index.html,patterns.html,brief.html,briefs/**,macro/**,xfeed/**,thesis/**,thesis_section.html,checklist_section.html,nav.js,finance.html,finance/**,x.html,tradingview/**,data/**,.github/**,README*}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:fn(patterns|valuation|mtf|scan|ind)",
      "destination": "/api/router?fn=:fn"
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)briefs' ':(exclude)macro' ':(exclude)xfeed' ':(exclude)thesis' ':(exclude)finance'"
}
