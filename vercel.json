{
  "buildCommand": null,
  "framework": null,
  "cleanUrls": true,
  "functions": {
    "api/router.py": {
      "maxDuration": 30,
      "excludeFiles": "{index.html,patterns.html,brief.html,briefs/**,macro/**,tradingview/**,data/**,.github/**,README*}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:fn(patterns|valuation|mtf|scan)",
      "destination": "/api/router?fn=:fn"
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)briefs' ':(exclude)macro'"
}